#!/usr/bin/env bash
# Pre-push gate: full verifier — source guardrails, Swift tests,
# headless verifier executables, a Release iOS build without signing,
# optional simulator/UI flows, and Chrome extension checks. CI mirrors
# the headless iOS, Chrome, and Android unit portions.
#
# Skip with `git push --no-verify` only when the user has explicitly
# asked you to.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

scripts/verify-rsvp-spec.sh
scripts/verify-ios-performance.sh
scripts/verify-chrome-ext.sh
scripts/verify-android.sh
