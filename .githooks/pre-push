#!/usr/bin/env bash
# Pre-push gate: full verifier — source guardrails, unit + integration
# Swift tests, headless verifier executables, a Release iOS build
# without signing, and the FastReadUITests happy-path XCUITest on the
# pinned iPhone 17 Pro simulator. Mirrors what CI runs on every push to
# main and every pull request.
#
# Skip with `git push --no-verify` only when the user has explicitly
# asked you to.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

scripts/verify-ios-performance.sh
scripts/verify-chrome-ext.sh
