{
  "name": "justread-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bun run build && playwright test",
    "e2e:install": "playwright install chromium",
    "zip": "bun run build && cd dist && zip -r ../justread-chrome.zip ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "happy-dom": "^15.7.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.2"
  }
}
