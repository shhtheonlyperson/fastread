{
  "name": "fastread",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "node --test",
    "guard:source": "scripts/check-source-guardrails.sh",
    "test:swift": "swift test",
    "perf:web": "node --test test/performance-guardrails.test.mjs",
    "perf:ios": "swift run FastReadPerformanceVerifier",
    "verify": "npm run verify:ios-performance",
    "verify:ios-performance": "scripts/verify-ios-performance.sh",
    "serve": "node server.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "14.0.0"
  }
}
