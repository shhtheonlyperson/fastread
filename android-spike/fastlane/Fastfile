opt_out_usage

default_platform(:android)

# Mirrors ~/proj/osho/android/fastlane/Fastfile (which is itself
# mirrored from the shh-mobile-release skill's android-local-fallback
# reference). Two lanes:
#   bundle exec fastlane verify    — build a signed AAB and run
#                                    bundletool validate, no upload.
#   bundle exec fastlane internal  — build + upload to Play Console
#                                    Internal testing track via the
#                                    Google Play Developer API.
#
# Service-account JSON path resolution order (first-found wins):
#   $FASTREAD_PLAY_SERVICE_ACCOUNT_JSON
#   $SUPPLY_JSON_KEY
#   $PLAY_STORE_JSON_KEY
#   ~/.config/shh/play-service-accounts/fastread-google-play-service-account.json
#   ~/.config/shh/play-service-accounts/shos-google-play-service-account.json
#   ~/.config/shh/play-service-accounts/google-service-account.fastread.json
#   ~/.config/shh/play-service-accounts/google-play-service-account.fastread.json
#   android-spike/google-service-account.fastread.json
#   android-spike/google-play-service-account.fastread.json

EXPECTED_FASTREAD_UPLOAD_SHA1 = "FASTREAD_PLAY_EXPECTED_UPLOAD_SHA1"
DEFAULT_SHARED_PLAY_SERVICE_ACCOUNT_EMAILS = "legacy-play-uploader@example.iam.gserviceaccount.com"

platform :android do
  private_lane :ensure_java_home do
    next ENV["JAVA_HOME"] unless ENV["JAVA_HOME"].to_s.empty?

    candidates = [
      "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
      "/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
    ]
    java_home = candidates.find { |path| File.executable?(File.join(path, "bin", "java")) }
    next nil unless java_home

    ENV["JAVA_HOME"] = java_home
    ENV["PATH"] = "#{File.join(java_home, "bin")}:#{ENV["PATH"]}"
    UI.message("Using JAVA_HOME=#{java_home}")
    java_home
  end

  private_lane :ensure_android_sdk do
    next ENV["ANDROID_HOME"] unless ENV["ANDROID_HOME"].to_s.empty?

    candidates = [
      File.expand_path("~/Library/Android/sdk"),
      "/opt/homebrew/share/android-commandlinetools",
      "/usr/local/share/android-commandlinetools"
    ]
    sdk_home = candidates.find { |path| File.directory?(File.join(path, "platforms", "android-35")) }
    next nil unless sdk_home

    ENV["ANDROID_HOME"] = sdk_home
    ENV["ANDROID_SDK_ROOT"] = sdk_home
    ENV["PATH"] = [
      File.join(sdk_home, "platform-tools"),
      File.join(sdk_home, "cmdline-tools", "latest", "bin"),
      ENV["PATH"]
    ].join(":")
    UI.message("Using ANDROID_HOME=#{sdk_home}")
    sdk_home
  end

  private_lane :play_json_key_path do
    explicit_path = ENV["FASTREAD_PLAY_SERVICE_ACCOUNT_JSON"] || ENV["SUPPLY_JSON_KEY"] || ENV["PLAY_STORE_JSON_KEY"]
    if explicit_path.to_s.empty?
      repo_root = File.expand_path("..", __dir__)
      candidates = [
        File.expand_path("~/.config/shh/play-service-accounts/fastread-google-play-service-account.json"),
        File.expand_path("~/.config/shh/play-service-accounts/shos-google-play-service-account.json"),
        File.expand_path("~/.config/shh/play-service-accounts/google-service-account.fastread.json"),
        File.expand_path("~/.config/shh/play-service-accounts/google-play-service-account.fastread.json"),
        "google-service-account.fastread.json",
        "google-play-service-account.fastread.json"
      ].map { |path| path.start_with?("/") ? path : File.absolute_path(path, repo_root) }

      candidates.find { |path| File.exist?(path) } ||
        File.expand_path("~/.config/shh/play-service-accounts/fastread-google-play-service-account.json")
    else
      File.absolute_path(explicit_path, File.expand_path("..", __dir__))
    end
  end

  private_lane :ensure_play_json_key do
    json_key = play_json_key_path
    unless File.exist?(json_key)
      UI.user_error!("Missing Google Play service-account JSON. Put it at ~/.config/shh/play-service-accounts/fastread-google-play-service-account.json, set FASTREAD_PLAY_SERVICE_ACCOUNT_JSON, or place a gitignored copy at android-spike/google-service-account.fastread.json.")
    end

    require "json"
    begin
      parsed = JSON.parse(File.read(json_key))
    rescue JSON::ParserError => e
      UI.user_error!("Google Play service-account JSON is not valid JSON: #{e.message}")
    end

    required_fields = ["type", "client_email", "private_key", "token_uri"]
    missing_fields = required_fields.select { |field| parsed[field].to_s.empty? }
    unless missing_fields.empty?
      UI.user_error!("Google Play service-account JSON is missing required fields: #{missing_fields.join(", ")}. This is probably not a service-account key.")
    end

    unless parsed["type"] == "service_account" && parsed["client_email"].end_with?(".gserviceaccount.com") && parsed["private_key"].include?("BEGIN PRIVATE KEY")
      UI.user_error!("Google Play credential must be a Google Cloud service-account JSON key, not Firebase google-services.json or an OAuth client file.")
    end
    allowed_shared = (ENV["FASTREAD_ALLOWED_SHARED_PLAY_SERVICE_ACCOUNT_EMAILS"] || DEFAULT_SHARED_PLAY_SERVICE_ACCOUNT_EMAILS).split(",").map(&:strip)
    unless parsed["client_email"].include?("fastread") || ENV["FASTREAD_ALLOW_SHARED_PLAY_SERVICE_ACCOUNT"] == "1" || allowed_shared.include?(parsed["client_email"])
      UI.user_error!("Google Play service-account email should be FastRead-specific or an allowlisted shared uploader. Got #{parsed['client_email']}. Grant the shared account access to the FastRead Play app before using it.")
    end

    json_key
  end

  private_lane :ensure_upload_key_matches_play do
    ensure_java_home

    require "open3"

    android_root = File.expand_path("..", __dir__)
    properties_path = File.join(android_root, "keystore.properties")
    UI.user_error!("Missing keystore properties at #{properties_path}") unless File.exist?(properties_path)

    properties = {}
    File.readlines(properties_path, chomp: true).each do |line|
      next if line.strip.empty? || line.strip.start_with?("#")
      key, value = line.split("=", 2)
      properties[key] = value if key && value
    end

    store_file = properties["storeFile"]
    store_password = properties["storePassword"]
    key_alias = properties["keyAlias"] || "justread"

    missing = []
    missing << "storeFile" if store_file.to_s.empty?
    missing << "storePassword" if store_password.to_s.empty?
    missing << "keyAlias" if key_alias.to_s.empty?
    UI.user_error!("keystore.properties is missing #{missing.join(', ')}") unless missing.empty?

    store_path = if store_file.start_with?("/")
                   store_file
                 else
                   # Gradle resolves `file(...)` in app/build.gradle.kts relative
                   # to the app module directory, not the Android root.
                   File.expand_path(store_file, File.join(android_root, "app"))
                 end
    UI.user_error!("Upload keystore not found at #{store_path}") unless File.exist?(store_path)

    keytool = ENV["JAVA_HOME"].to_s.empty? ? "keytool" : File.join(ENV["JAVA_HOME"], "bin", "keytool")
    stdout, stderr, status = Open3.capture3(
      keytool,
      "-list",
      "-v",
      "-keystore",
      store_path,
      "-alias",
      key_alias,
      "-storepass",
      store_password
    )
    UI.user_error!("Unable to inspect upload keystore: #{stderr}") unless status.success?

    actual_sha1 = stdout[/SHA1:\s*([A-F0-9:]+)/, 1]
    UI.user_error!("Unable to read SHA1 fingerprint from #{store_path}") if actual_sha1.to_s.empty?

    expected_sha1 = ENV["FASTREAD_PLAY_EXPECTED_UPLOAD_SHA1"] || EXPECTED_FASTREAD_UPLOAD_SHA1
    unless actual_sha1 == expected_sha1
      UI.user_error!("Upload keystore SHA1 mismatch. Play expects #{expected_sha1}, but #{store_path} signs with #{actual_sha1}. Recover the original upload keystore or request a Play upload-key reset before uploading.")
    end

    UI.success("Upload keystore SHA1 matches Play Console expectation")
  end

  private_lane :build_release_bundle do
    ensure_java_home
    ensure_android_sdk
    gradle(task: ":app:bundleRelease", project_dir: ".")
    File.expand_path("app/build/outputs/bundle/release/app-release.aab", File.expand_path("..", __dir__))
  end

  desc "Build and validate the Android app bundle without uploading to Play Console"
  lane :verify do
    aab_path = build_release_bundle
    if `which bundletool`.strip.empty?
      UI.message("bundletool not on PATH — skipping validate. Install with: brew install bundletool")
    else
      sh("bundletool validate --bundle=#{aab_path}")
    end
    UI.success("Built #{aab_path}")
  end

  desc "Check Play API credential and upload signing key before building or uploading"
  lane :release_preflight do
    ensure_play_json_key
    ensure_upload_key_matches_play
    UI.success("Android release credentials are ready")
  end

  desc "Build and upload the Android app bundle to Play Console internal testing"
  lane :internal do
    release_preflight
    json_key = play_json_key_path
    aab_path = build_release_bundle
    upload_to_play_store(
      json_key: json_key,
      track: "internal",
      release_status: "completed",
      aab: aab_path,
      skip_upload_screenshots: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true
    )
  end

  desc "Build and upload the Android app bundle as a draft (first-time upload before Play Console accepts the package id)"
  lane :draft do
    release_preflight
    json_key = play_json_key_path
    aab_path = build_release_bundle
    upload_to_play_store(
      json_key: json_key,
      track: "internal",
      release_status: "draft",
      aab: aab_path,
      skip_upload_screenshots: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true
    )
  end
end
