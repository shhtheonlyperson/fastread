{
  "expo": {
    "name": "FastRead",
    "slug": "fastread",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fastread",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shhtheonlyperson.fastread"
    },
    "web": {
