{
  "expo": {
    "name": "JustRead",
    "slug": "fastread",
    "version": "0.2.0",
    "icon": "./assets/JustReadIcon.png",
    "orientation": "default",
    "scheme": "fastread",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/JustReadIcon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.shhtheonlyperson.fastread",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-screen-orientation",
      "./plugins/with-ios-app-icons.cjs"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30524a6b-d9f1-40a1-b75a-43e289b49812"
      }
    }
  }
}
