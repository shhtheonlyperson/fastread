# Convenience copy for EpubE2ETests — see Tests/FastReadCoreTests/EpubE2ETests.swift.
# Real EPUBs are typically copyrighted; never commit them.
/test.epub
/books/

# Maestro flow screenshots get dumped at the repo root by the
# `takeScreenshot` step. Run logs live under ~/.maestro/tests/.
/[0-9][0-9]-*.png

# Android spike build output. Keep the source under android-spike/
# committed so the perf decision is reproducible, but ignore the
# generated Gradle / dex / apk artifacts.
android-spike/.gradle/
android-spike/build/
android-spike/app/build/
android-spike/local.properties

# NEVER commit upload signing material. If the keystore.jks is lost,
# Play App Signing flow lets us reset the upload key via Play Console
# support, but the file + passwords here unlock signed releases for
# this app, so they stay local-only.
android-spike/upload-keystore.jks
android-spike/keystore.properties
android-spike/google-service-account*.json
android-spike/fastlane/report.xml
